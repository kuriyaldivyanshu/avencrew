# Lifecycle scripts are disabled by default for this workspace; per-package
# decisions are recorded in pnpm-workspace.yaml (allowBuilds).
#
# Native binaries are never fetched by a package script in this project:
# esbuild and TypeScript resolve their platform packages from the dependency
# tree, and Electron's Darwin ARM64 archive is fetched separately and verified
# against docs/implementation/p0-release-selection-v1.json before extraction.
ignore-scripts=true

# Do not let pnpm download a second copy of itself.
#
# `packageManager: pnpm@12.9.1` makes pnpm self-provision into PNPM_HOME, which
# writes a second YAML document into the project's pnpm-lock.yaml. That document
# has no apps/desktop importer, so `--frozen-lockfile` had no specifier to compare
# and manifest drift passed silently. tools/bootstrap already provides the exact
# pinned pnpm, so that second copy is redundant as well as harmful.
manage-package-manager-versions=false

# Never let a script invocation mutate node_modules first.
#
# `pnpm run <script>` auto-installs when the manifest and lockfile disagree, and
# that auto-install is NOT frozen. A script named `install:anything` is doubly
# broken: pnpm parses `install:frozen` as the `install` command plus an argument.
# The combination meant a "frozen" install could silently rewrite the lockfile
# and then pass against the lockfile it had just written.
#
# Install with `pnpm install --frozen-lockfile` directly, never through a script.
verify-deps-before-run=false
