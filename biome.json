{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "biome.json",
      "package.json",
      "apps/desktop/package.json",
      "packages/contracts-ts/package.json",
      "apps/desktop/src/**",
      "apps/desktop/build.mjs",
      "packages/contracts-ts/src/**",
      "packages/contracts-ts/examples/**",
      "tools/contracts/**",
      "tools/dev/*.mjs",
      "!**/wire.ts",
      "!**/wire.schema.json",
      "!**/wire-validator.*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/contracts-ts/examples/conformance.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
